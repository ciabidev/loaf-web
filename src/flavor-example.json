{
	name: 'rain',
	description: '☀️ blue theme',
	iconPath: '/flavor_icons/rain.png',
	isDark: false,
	cssVariables: {
		'--loaf-surface': '#ffffff',
		'--loaf-text': '#282828',
		'--loaf-text-on-accent': '#ffffff',/* text on the main color */
		'--loaf-accent': '#4273fa', /* main accent you'll see everywhere */
		'--loaf-accent-secondary': '#455fa8', /* main color's brother, you'll see this on links and smaller stuff; half the time */
		'--loaf-surface-secondary': '#eaeef5', /* for stuff like default buttons and cards; the background on the background */
		'--loaf-success': '#40d672',
		'--loaf-warning': '#ffd63a',
		'--loaf-error': '#f7374f',
		'--loaf-nav-hover-bg': '#00000033', /* for hovering over navbar tabs */
		'--loaf-nav-bg': '#f4f4f4', /* background of the navbar */
		'--loaf-nav-highlight': '#455fa8', /* color of the navbar tab's text */
		'--loaf-nav-active-highlight': '#ffffff' /* color of the navbar tab (not text) WHEN ACTIVE */
	}
},
