{
	"name": "@ciabi/loaf-web",
	"version": "0.1.0",
	"description": "A cozy, extensible Svelte component library.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"package": "svelte-package",
		"package:watch": "svelte-package --watch",
		"prepublishOnly": "npm run check && npm run package && publint",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --workspace src --tsconfig ../tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --workspace src --tsconfig ../tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles/loaf.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@iconify-json/hugeicons": "^1.2.35",
		"@iconify/json": "^2.2.379",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^24.3.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"mdsvex": "^0.12.3",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"unplugin-icons": "^22.2.0",
		"vite": "^6.2.6"
	},
	"keywords": [
		"svelte",
		"components",
		"design-system",
		"ui"
	],
	"overrides": {
		"esbuild": "0.25.4"
	},
	"dependencies": {
		"@iconify-svelte/hugeicons": "github:iconify/icons-svelte#hugeicons",
		"marked": "^16.2.1",
		"shiki": "^3.12.0"
	}
}
