{
	"name": "@ciabi/loaf-web",
	"version": "0.1.1",
	"description": "a cozy, extensible Svelte component library.",
	"author": "wheatwhole",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ciabidev/loaf-web.git"
	},
	"homepage": "https://github.com/ciabidev/loaf-web#readme",
	"bugs": {
		"url": "https://github.com/ciabidev/loaf-web/issues"
	},
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"package": "svelte-package",
		"package:watch": "svelte-package --watch",
		"prepublishOnly": "npm run quality && npm run smoke:consumer",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --workspace src --tsconfig ../tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --workspace src --tsconfig ../tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run --passWithNoTests || true",
		"quality": "npm run lint && npm run check && npm run test && npm run package && publint && npm run build",
		"smoke:consumer": "node scripts/consumer-smoke.mjs"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles/loaf.css",
		"./reset.css": "./dist/styles/reset.css",
		"./fonts.css": "./dist/styles/fonts.css",
		"./app.css": "./dist/styles/app.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^24.3.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "29.1.1",
		"mdsvex": "^0.12.3",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.2.6",
		"vitest": "4.1.10"
	},
	"keywords": [
		"svelte",
		"components",
		"design-system",
		"ui"
	],
	"overrides": {
		"esbuild": "0.25.4"
	},
	"dependencies": {
		"dompurify": "^3.4.15",
		"isomorphic-dompurify": "^3.19.0",
		"marked": "^16.4.2",
		"shiki": "^3.12.0"
	}
}
